 #include <cstring>
 
 using namespace touchgfx;
@@ -65,13 +66,33 @@ void TileCanvas::draw(const Rect& area) const
                 continue;
             }
 
-            Bitmap     bmp(id);
-            const Rect src(0, 0,
-                           static_cast<int16_t>(bmp.getWidth()),
-                           static_cast<int16_t>(bmp.getHeight()));
-            const int16_t drawX = static_cast<int16_t>(absDX + cellLocalX);
-            const int16_t drawY = static_cast<int16_t>(absDY + cellLocalY);
-            HAL::lcd().drawPartialBitmap(bmp, drawX, drawY, src, 255, true);
+            // EXPERIMENT C2: blitCopy with proper screen-rect intersection
+            // so blitRect is correctly source-relative. `source` is the
+            // bitmap's absolute position+size; `blitRect` is the dirty
+            // rect intersected with that source, translated to coords
+            // relative to source.x/y.
+            Bitmap bmp(id);
+            const uint8_t* pixels = Bitmap::dynamicBitmapGetAddress(id);
+            const int16_t srcX = static_cast<int16_t>(absDX + cellLocalX);
+            const int16_t srcY = static_cast<int16_t>(absDY + cellLocalY);
+            const Rect source(srcX, srcY,
+                              static_cast<int16_t>(bmp.getWidth()),
+                              static_cast<int16_t>(bmp.getHeight()));
+
+            const int16_t ix0 = std::max(source.x, absRect.x);
+            const int16_t iy0 = std::max(source.y, absRect.y);
+            const int16_t ix1 = std::min(int16_t(source.x + source.width),
+                                         int16_t(absRect.x + absRect.width));
+            const int16_t iy1 = std::min(int16_t(source.y + source.height),
+                                         int16_t(absRect.y + absRect.height));
+            if (ix1 <= ix0 || iy1 <= iy0) {
+                continue;
+            }
+            const Rect blitRect(int16_t(ix0 - source.x),
+                                int16_t(iy0 - source.y),
+                                int16_t(ix1 - ix0),
+                                int16_t(iy1 - iy0));
+            HAL::lcd().blitCopy(pixels, Bitmap::ABGR2222, source, blitRect, 255, false);
         }
     }
 }
